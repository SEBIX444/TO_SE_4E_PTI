<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NotatkiMobilne.MainPage"
    Title="Moje notatki">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="Moje notatki"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Grid
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Entry
                x:Name="NoteEntry"
                Grid.Column="0"
                Placeholder="Nowy element"
                HorizontalOptions="Fill" />

            <Button
                Grid.Column="1"
                Text="Dodaj"
                Clicked="OnAddButtonClicked"
                BackgroundColor="#DC143C"
                TextColor="White"
                CornerRadius="8" />

        </Grid>

            <CollectionView
            x:Name="NotesCollectionView"
            ItemsSource="{Binding Notes}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="12"
                        Stroke="#DDDDDD"
                        StrokeShape="8">

                        <Label
                            Text="{Binding .}"
                            FontSize="18" />

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>